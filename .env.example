# Directory where downloaded music is stored (absolute path or relative to project root)
MUSIC_DIR=./music

# MusicBrainz user-agent email (helps MB identify your app — use something real)
MB_USERAGENT_EMAIL=musicfinder@localhost

# Override internal paths if needed (usually leave as defaults)
# DB_PATH=/app/data/db/musicfinder.db
# COOKIES_PATH=/app/cookies/cookies.txt
# TMP_DIR=/tmp/musicfinder
